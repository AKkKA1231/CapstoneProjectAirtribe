PRISM_ENVIRONMENT=development
PRISM_LOG_LEVEL=INFO
PRISM_EXPOSE_API_DOCS=true

PRISM_DATABASE_ENABLED=true
PRISM_DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5432/prism
PRISM_DATABASE_POOL_SIZE=10
PRISM_DATABASE_MAX_OVERFLOW=10
PRISM_DATABASE_POOL_TIMEOUT_SECONDS=5
PRISM_DATABASE_STATEMENT_TIMEOUT_SECONDS=15
PRISM_DATABASE_LOCK_TIMEOUT_MS=2000
PRISM_SEED_CONFIG_DIR=../config

PRISM_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PRISM_PROVIDER_READ_TIMEOUT_SECONDS=60
PRISM_PROVIDER_WRITE_TIMEOUT_SECONDS=10
PRISM_PROVIDER_POOL_TIMEOUT_SECONDS=5
PRISM_PROVIDER_MAX_CONNECTIONS=100
PRISM_PROVIDER_MAX_KEEPALIVE_CONNECTIONS=20
PRISM_PROVIDER_MAX_RETRIES=1
PRISM_PROVIDER_BACKOFF_BASE_MS=50

# Create this secret at https://console.groq.com/keys. Never commit a real value.
GROQ_API_KEY=

PRISM_CACHE_ENABLED=true
PRISM_CACHE_TTL_SECONDS=86400
PRISM_CACHE_SIMILARITY_THRESHOLD=0.82
PRISM_CACHE_SCHEMA_VERSION=1
PRISM_CACHE_MAXIMUM_TEMPERATURE=0.2
PRISM_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
PRISM_RECONCILIATION_ENABLED=true
PRISM_RECONCILIATION_INTERVAL_SECONDS=300
PRISM_RECONCILIATION_STALE_SECONDS=900

# Replace these values outside local development. Never commit real credentials.
PRISM_AUTH_PEPPER=development-only-change-this-auth-pepper
PRISM_ADMIN_API_KEY=development-only-change-this-admin-key

